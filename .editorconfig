root = true

[*.py]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4
tab_width = 4
max_line_length = 160

# Conserver les commentaires de fin de ligne en CSS ; ne séparer que les explications longues ou de section.
# Les blocs HTML simples et les règles CSS à une déclaration peuvent rester sur une seule ligne.
[*.{html,css,js}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4
tab_width = 4
